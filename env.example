###############################################################
# ENV EXAMPLE - PENROSE FRONTEND (Next.js 14 App Router + TS)
# Duplicar para .env.local (dev) e .env.production (deploy).
# Nunca commitar chaves reais de produção.
###############################################################

########################
# Ambientes base
########################
# development | test | production
NODE_ENV=development

# Usado por next.config.js (generateBuildId). Opcional.
#BUILD_ID=

########################
# API / Backend
########################
# Base pública (exposta no bundle) para chamadas client-side.
# Preferir NEXT_PUBLIC_API_BASE_URL (novo). Mantidos aliases para retrocompat.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001
# Mantidos por compatibilidade (fallbacks):
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001
NEXT_PUBLIC_API_BASE_URL=http://localhost:4001

# Base server-side (se diferente; ex: internal cluster URL)
#NEXT_PUBLIC_API_BASE_URL=http://localhost:4001

# Domínio usado em cookies (ex: .minhaempresa.com). Deixe vazio em dev.
#COOKIE_DOMAIN=

########################
# Supabase (se usado)
########################
# URL do projeto Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
# Chave pública (anon) — pode estar embutida no client
SUPABASE_ANON_KEY=coloque_sua_chave_anon_aqui
# Chave service role (NÃO colocar em variáveis iniciando com NEXT_PUBLIC_)
# Apenas usar em ambientes server (Edge/Route Handlers) – nunca no client.
SUPABASE_SERVICE_ROLE_KEY=coloque_sua_service_role_key_somente_no_backend

########################
# Auth / Segurança
########################
# (Opcional) Segredo para assinar tokens próprios (se implementar)
#AUTH_JWT_SECRET=mude_este_valor

# Credenciais de admin fake/local (apenas para ambiente de desenvolvimento)
ADMIN_USER=admin@teste.com
ADMIN_PASS=123456

########################
# Feature Flags / UI
########################
#EXPERIMENTAL_SHOW_3D=true
#ENABLE_NEW_CART_FLOW=false

########################
# Observabilidade (opcionais)
########################
#SENTRY_DSN=
#LOG_LEVEL=debug

########################
# Build / Otimização
########################
# Força compressão extra ou comportamento de cache específico se usado em scripts
#ASSET_CACHE_TTL=31536000

########################
# Público (sempre com prefixo NEXT_PUBLIC_)
########################
# Exemplo de flag acessível no browser
#NEXT_PUBLIC_ENABLE_LANDING_EXPERIMENT=false

###############################################################
# Notas:
# 1. Variáveis com prefixo NEXT_PUBLIC_ são enviadas ao cliente.
# 2. Não exponha chaves sensíveis (ex: SUPABASE_SERVICE_ROLE_KEY) no client.
# 3. Ajuste NEXT_PUBLIC_API_BASE_URL em produção para a URL real do backend.
# 4. Remova variáveis legadas não usadas para evitar confusão futuramente.
# 5. Caso migre totalmente para src/app e padronize nomes, remova NEXT_PUBLIC_API_BASE e NEXT_PUBLIC_API_URL.
###############################################################
